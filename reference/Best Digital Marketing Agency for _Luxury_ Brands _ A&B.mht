@charset "utf-8";

@font-face { font-family: "Open Sans"; font-style: normal; font-weight: 400; font-stretch: 100%; src: url("https://collectcdn.com/fonts/opensans.woff2") format("woff2"); unicode-range: U+0-FF, U+131, U+152-153, U+2BB-2BC, U+2C6, U+2DA, U+2DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }

*, ::after, ::before { box-sizing: border-box; font-family: "Open Sans", sans-serif; text-size-adjust: 100%; -webkit-font-smoothing: antialiased; }

html, body { height: 100%; margin: 0px !important; }

.chatbox { max-width: 550px; margin: 0px auto 40px; padding: 20px 15px; }

.conversation-part--animation { animation: 0.6s ease 0s 1 normal both running moveFromBottom; }

.conversation-part { margin-bottom: 2px; overflow: hidden; }

.conversation-part .same-row { display: inline-block; vertical-align: top; }

.conversation-part--question { max-width: 100%; margin-bottom: 8px; }

.conversation-part--answer { max-width: 100%; margin: 20px 0px 25px; }

.avatar-wrapper { height: 28px; width: 28px; max-width: 10%; margin-right: 10px; }

.avatar { height: 28px; width: 28px; border-radius: 50%; left: 0px; top: 2px; background-size: 29px auto; background-repeat: no-repeat; background-position: 50% center; }

.bubble { border-radius: 1.3em; border: 1px solid rgba(0, 0, 0, 0); padding: 10px 17px; transition: width 2s; word-break: break-word; line-height: 20px; background-color: rgb(248, 248, 248); text-align: initial; }

.question-part { max-width: 86%; transition: width 2s; overflow: hidden; }

.question-part img, .question-part iframe { display: block; max-width: 100%; margin: 10px auto; }

.bubble-inline { display: inline-block; }

.no-border { border-width: 0px; }

.text-center { text-align: center; }

.bubble-label { color: rgb(69, 90, 100); font-size: 15.5px; }

.bubble-label div { font-weight: 400; }

.send-button { background-image: url("data:image/svg+xml;base64,"); background-size: 20px auto; background-position: 70% 18px; background-repeat: no-repeat; }

.send-button.send-button-active { background-image: url("data:image/svg+xml;base64,"); }

.fixed-height { position: absolute; top: 0px; right: 0px; bottom: 0px; width: 100%; padding-top: 55px; padding-bottom: 25px; overflow-y: auto; }

.fixed-height.chatbox-container-thankyou { padding-top: 0px; }

.fixed-height.chatbox-container-thankyou .chatbox { display: initial; }

.fixed-height.chatbox-container-thankyou .conversation-part { display: none; }

.text-rtl { direction: rtl; }

.composer { z-index: 1; position: absolute; max-width: 550px; height: auto; max-height: 100%; overflow-y: auto; bottom: 0px; left: 0px; right: 0px; margin: auto; width: 100%; padding: 0px; }

.chat-buttons { text-align: center; z-index: 1; position: absolute; max-width: 550px; height: auto; max-height: 100%; overflow-y: auto; bottom: 63px; left: 0px; right: 0px; margin: auto; width: 100%; padding: 0px; }

.chat-buttons button { cursor: pointer; outline: none; background-color: rgb(255, 255, 255); padding: 2px 10px; margin: 0px 2px; font-size: 16.5px; border-radius: 6.4rem; border: 1px solid rgb(207, 216, 220); display: inline-block; }

.header-wrapper { max-width: 550px; position: relative; margin: auto; display: block; }

.restart-launcher { z-index: 999; cursor: pointer; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; outline: none; background-size: 15px auto; background-repeat: no-repeat; background-position: 50% center; position: absolute; right: 10px; top: 10px; background-image: url("data:image/png;base64,"); width: 30px; height: 30px; background-color: rgb(102, 102, 102); border-radius: 50%; }

.progress-bar { top: 0px; left: 0px; height: 5px; z-index: 1; appearance: none; border: 0px; position: absolute; width: 100%; background-color: rgba(0, 0, 0, 0); color: rgb(255, 255, 0); transition: all, 0.1s, linear; }

.progress-bar::-webkit-progress-bar { background: rgb(255, 255, 255); transition: width 500ms; }

.progress-bar::-webkit-progress-value { background: rgb(0, 119, 229); transition: width 500ms; }

.powered-by { z-index: 0; overflow: hidden; position: absolute; bottom: 0px; right: 0px; width: 100%; height: 50px; text-align: center; background-color: rgb(255, 255, 255); }

.powered-by .powered-title { font-family: "Open Sans", sans-serif; font-size: 13px; padding: 16px; max-width: 100%; color: rgb(136, 136, 136); letter-spacing: 0.2px; display: block; white-space: nowrap; text-decoration: none; overflow: hidden; text-align: inherit; text-overflow: ellipsis; outline: none; }

.fullpage .powered-by { background-color: initial; }

@-webkit-keyframes moveFromBottom { 
  0% { transform: translateY(50px); }
}

@keyframes moveFromBottom { 
  0% { transform: translateY(50px); }
}

.float-right { float: right; }

.bubble-loader-wrapper { min-height: 38px; padding: 13px !important; }

.bubble-loader { height: 12px; width: 12px; float: left; margin: 0px 2px; background-color: rgb(158, 158, 161); display: block; border-radius: 50%; opacity: 0.4; }

.bubble-loader :nth-of-type(1) { animation: 1s ease 0.3333s infinite normal none running blink; }

.bubble-loader:nth-of-type(2) { animation: 1s ease 0.6666s infinite normal none running blink; }

.bubble-loader:nth-of-type(3) { animation: 1s ease 0.9999s infinite normal none running blink; }

@-webkit-keyframes blink { 
  50% { opacity: 1; }
}

@keyframes blink { 
  50% { opacity: 1; }
}

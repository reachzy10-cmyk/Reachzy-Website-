.social-wrapper { position: relative; }

.social-element { display: inline-block; margin: 0px 5px; }

.social-element button { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; background: transparent; cursor: pointer; outline: none; }

.social-element button svg { font-size: 20px; }

#show-social ul { padding: 0px; margin: 10px 0px; display: flex; justify-content: center; flex-wrap: wrap; }

.option-class { color: red; }

.social-edit-btn i { font-size: 16px; }

.social-edit-btn { background: transparent; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; outline: none; cursor: pointer; }

#prettydropdown-dropdown { margin-right: 10px; }

#prettydropdown-dropdown ul { font-size: 16px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; outline: none; }

#prettydropdown-dropdown li i { font-size: 16px; padding-right: 5px; }

.social-edit-close { position: absolute; right: 3px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; top: 6px; cursor: pointer; }

.social-edit-close i { font-size: 15px; }

.video-bg video { position: fixed; right: 0px; bottom: 0px; min-width: 100%; min-height: 100%; }

.overlay { position: fixed; bottom: 0px; background: rgba(0, 0, 0, 0.5); min-width: 100%; padding: 100px; min-height: 100%; }

.social-edit:hover { border: 1px solid rgb(47, 165, 204); box-shadow: rgba(0, 0, 0, 0.075) 0px 1px 1px inset, rgba(102, 175, 233, 0.6) 0px 0px 3px; }

.social { border: 1px dashed transparent; position: relative; }


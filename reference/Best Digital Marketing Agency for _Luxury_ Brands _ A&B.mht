@charset "utf-8";

.payment-question .bubble-label p { margin-top: 10px; margin-bottom: 10px; }

.payment-question .amount-label { font-size: 24px; font-weight: 500; letter-spacing: -0.5px; color: rgb(51, 51, 51); margin-bottom: 24px; font-family: system-ui, sans-serif; }

.payment-question .payment-method-list { display: flex; flex-wrap: wrap; gap: 10px; }

.payment-question .payment-method-list .payment-method-item { padding: 10px 16px; border-radius: 24px; border: 1px solid rgb(207, 207, 207); display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 14px; }

.payment-question .payment-method-list .payment-method-item img { border-radius: 4px; flex-shrink: 0; margin: 0px; }

.payment-question .payment-method-list .payment-method-item.selected { border-color: rgb(0, 0, 0); background-color: rgb(240, 240, 240); }

.payment-question .pay-button { width: 100%; margin-top: 10px; margin-bottom: 10px; padding: 12px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; font-weight: bold; border-radius: 24px; cursor: pointer; transition: 0.2s; }

.payment-question .pay-button:disabled { opacity: 0.5; cursor: not-allowed; }

.payment-question .pay-button:not(:disabled):hover { transform: scale(1); }

.payment-question .pay-button:not(:disabled):active { transform: scale(0.98); }

@keyframes scaleIn { 
  0% { transform: scale(0); }
  50% { transform: scale(1.1); }
  100% { transform: scale(1); }
}

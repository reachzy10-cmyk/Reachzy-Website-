*, ::after, ::before { box-sizing: border-box; margin: 0px; padding: 0px; }

h1, h2, h3, h4, h5, h6 { font-weight: 400; line-height: 1.3; }

p { font-weight: 400; line-height: 1.6; }

article, aside, details, figcaption, figure, footer, header, hgroup, main, nav, section, summary { display: block; }

audio, canvas, video { display: inline-block; vertical-align: middle; }

audio:not([controls]) { display: none; height: 0px; }

[hidden] { display: none; }

html { text-size-adjust: 100%; }

body, html { width: 100%; }

body { font-family: Poppins, sans-serif; font-weight: 400; margin: 0px; overflow-x: hidden; padding: 0px; }

abbr[title] { border-bottom: 1px dotted; }

b, strong { font-weight: 700; }

dfn { font-style: italic; }

hr { box-sizing: content-box; height: 0px; }

mark { background: rgb(255, 255, 0); color: rgb(0, 0, 0); }

code, kbd, pre, samp { font-family: monospace, serif; font-size: 1em; }

pre { white-space: pre-wrap; }

small { font-size: 80%; }

sub, sup { font-size: 75%; line-height: 0; position: relative; vertical-align: baseline; }

sup { top: -0.5em; }

sub { bottom: -0.25em; }

svg:not(:root) { overflow: hidden; }

figure { margin: 0px; }

fieldset { border: 1px solid silver; margin: 0px 2px; padding: 0.35em 0.625em 0.75em; }

legend { border: 0px; padding: 0px; }

button, input, select, textarea { font-size: 100%; margin: 0px; }

button, input { line-height: normal; }

button, select { text-transform: none; }

button, html input[type="button"], input[type="reset"], input[type="submit"] { appearance: button; cursor: pointer; }

button[disabled], html input[disabled] { cursor: default; }

input[type="checkbox"], input[type="radio"] { box-sizing: border-box; padding: 0px; }

input[type="search"] { appearance: textfield; box-sizing: content-box; }

input[type="search"]::-webkit-search-cancel-button, input[type="search"]::-webkit-search-decoration { appearance: none; }

textarea { overflow: auto; vertical-align: top; }

table { border-collapse: collapse; border-spacing: 0px; }

button, input, select, textarea { font-family: inherit; font-size: inherit; line-height: inherit; }

button, input, select[multiple], textarea { background-image: none; }

a { transition: 0.2s ease-in-out; }

a, a:hover { text-decoration: none; }

a:active, a:focus, a:hover { outline: 0px; text-decoration: none; }

img { border: 0px; max-width: 100%; vertical-align: middle; }

img.obj-cover { height: 100%; object-fit: cover; width: 100%; }

img.obj-contain { height: 100%; object-fit: contain; width: 100%; }

ul { list-style: none; margin: 0px; padding: 0px; }

dl, ol, ul { margin-block: 0px; }

hr { border-width: 1px 0px 0px; border-style: solid none none; border-color: rgb(207, 209, 212) currentcolor currentcolor; border-image: none; margin-bottom: 20px; margin-top: 20px; }

.pt-0 { padding-top: 0px !important; }

.button { align-items: center; background: rgb(255, 255, 255); border: 1px solid rgb(70, 63, 58); border-radius: 47px; color: var(--fontColor); display: inline-flex; font-size: 16px; font-weight: 300; height: 50px; padding: 2px 60px 2px 24px; position: relative; text-decoration: none; transition: 0.2s ease-in-out; white-space: nowrap; }

.button span.button-text { text-decoration: none; z-index: 9; }

.button span.button-arrow { align-items: center; background: rgb(70, 63, 58); border-radius: 44px; color: rgb(255, 255, 255); display: inline-flex; height: 44px; justify-content: end; position: absolute; right: 2px; top: 50%; transform: translateY(-50%); width: 44px; z-index: 1; }

.button span.button-arrow, .button span.button-arrow .arrowIcon { transition: 0.2s ease-in-out; }

.button span.button-arrow .arrowIcon { fill: rgb(255, 255, 255); margin-right: 10px; width: 21px; }

.button.black { fill: rgb(255, 255, 255); background: rgb(70, 63, 58); color: rgb(255, 255, 255); }

.button.black span.button-arrow { background: rgb(255, 255, 255); color: var(--fontColor); }

.button.black:hover { background: rgb(70, 63, 58); color: var(--fontColor); }

.button.big { font-size: 24px; height: 74px; padding-right: 90px; }

.button.big span.button-arrow { height: 68px; padding-right: 5px; width: 58px; }

.button.big:hover .button-arrow { padding-right: 5px; }

.button:hover { background: rgb(255, 255, 255); color: rgb(255, 255, 255); }

.button:hover span.button-arrow { width: calc(100% - 5px); }

.button:active, .button:focus, .button:hover { outline: none; text-decoration: none; }

button:focus { outline: none; }

.ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.ellipsis2 { -webkit-line-clamp: 2; }

.ellipsis2, .ellipsis3 { -webkit-box-orient: vertical; display: -webkit-box; overflow: hidden; white-space: normal; }

.ellipsis3 { -webkit-line-clamp: 3; }

.ellipsis4 { -webkit-line-clamp: 4; -webkit-box-orient: vertical; display: -webkit-box; overflow: hidden; white-space: normal; }

.flex-justify { align-items: center; display: flex; flex-direction: row; justify-content: space-between; }

